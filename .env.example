# Copy this file to .env and fill in your own values.

# Required by `diarize_transcribe.py` (Deepgram transcription + diarization).
# Get one at https://console.deepgram.com/ -> your project -> API Keys -> Create.
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Required by `core.embedder.OpenAIEmbedder` (--embedder openai, the default).
# Not needed if you only use --embedder local.
OPENAI_API_KEY=your-openai-api-key-here

# Required by `core.db` (PostgreSQL + pgvector + pg_trgm).
POSTGRES_USER=your-postgres-username-here
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=audio_retrieval
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
